+	u32 add_bootconfig_parameters(char *params, ulong params_size,
+	                              ulong bootconfig_start_addr, u32 bootconfig_size)
+	{
+	    ulong data_size;
+	    ulong new_data_size;
+	    ulong old_total_size;
+	    ulong new_total_size;
+	    ulong trailer_size;
+
+	    if (!params || !bootconfig_start_addr)
+	        return (u32)-1;
+
+	    if (!params_size)
+	        return 0;
+
+	    old_total_size = bootconfig_size;
+	    data_size = bootconfig_size;
+
+	    /*
+	     * If a trailer exists, exclude it from the data size.
+	     * The new parameters must be appended before the trailer.
+	     */
+	    if (bootconfig_size >= BOOTCONFIG_TRAILER_SIZE &&
+	        is_trailer_present(bootconfig_start_addr +
+	                           bootconfig_size)) {
+	        data_size -= BOOTCONFIG_TRAILER_SIZE;
+	    }
+
+	    /*
+	     * Check that the resulting total length fits in u32.
+	     * This function assumes the destination has sufficient RAM.
+	     */
+	    if (params_size > (u32)-1 - data_size -
+	                      BOOTCONFIG_TRAILER_SIZE)
+	        return (u32)-1;
+
+	    /*
+	     * Append the new bootconfig parameter after existing data.
+	     */
+	    memcpy((void *)(bootconfig_start_addr + data_size),
+	           params, params_size);
+
+	    new_data_size = data_size + params_size;
+
+	    /*
+	     * Rebuild the trailer with the correct size and checksum.
+	     */
+	    trailer_size = add_trailer(bootconfig_start_addr,
+	                               new_data_size);
+
+	    if (trailer_size != BOOTCONFIG_TRAILER_SIZE)
+	        return (u32)-1;
+
+	    new_total_size = new_data_size + trailer_size;
+
+	    return (u32)(new_total_size - old_total_size);
+	}
 
