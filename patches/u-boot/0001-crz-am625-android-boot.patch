-
-		strcpy(newcmdline, bootargs);
-		strcat(newcmdline, " ");
-		strcat(newcmdline, bflow->cmdline);
-
-		/* Free the previous cmdline and replace it */
-		free(bflow->cmdline);
-		bflow->cmdline = newcmdline;
-	}
-
-	return 0;
+    const char *bootargs = env_get("bootargs");
+    const char *cmdline = bflow->cmdline;
+    char *newcmdline, *out;
+    const char *p;
+    size_t len;
+
+    if (!bootargs || !*bootargs)
+        return 0;
+
+    len = strlen(bootargs) + (cmdline ? strlen(cmdline) : 0) + 2;
+    newcmdline = malloc(len);
+    if (!newcmdline)
+        return -ENOMEM;
+
+    out = newcmdline;
+    p = bootargs;
+
+    while (*p) {
+        const char *end;
+        const char *eq;
+        size_t token_len;
+        bool skip = false;
+
+        while (*p == ' ')
+            p++;
+
+        if (!*p)
+            break;
+
+        end = strchr(p, ' ');
+        if (!end)
+            end = p + strlen(p);
+
+        token_len = end - p;
+        eq = memchr(p, '=', token_len);
+
+        if (eq && token_len >= 12 &&
+            !strncmp(p, "androidboot.", 12) && cmdline) {
+            skip = android_arg_exists(cmdline, p, eq - p);
+        }
+
+        if (!skip) {
+            if (out != newcmdline)
+                *out++ = ' ';
+            memcpy(out, p, token_len);
+            out += token_len;
+        }
+
+        p = end;
+    }
+
+    if (cmdline && *cmdline) {
+        if (out != newcmdline)
+            *out++ = ' ';
+        memcpy(out, cmdline, strlen(cmdline));
+        out += strlen(cmdline);
+    }
+
+    *out = '\0';
+
+    free(bflow->cmdline);
+    bflow->cmdline = newcmdline;
+
+    return 0;
 }
 
