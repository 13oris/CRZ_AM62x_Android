+static bool android_arg_exists(const char *cmdline,
+                               const char *key, size_t key_len)
+{
+    const char *p = cmdline;
+
+    while (p && *p) {
+        const char *end;
+
+        while (*p == ' ')
+            p++;
+
+        if (!*p)
+            break;
+
+        end = strchr(p, ' ');
+        if (!end)
+            end = p + strlen(p);
+
+        if ((size_t)(end - p) > key_len &&
+            !strncmp(p, key, key_len) && p[key_len] == '=')
+            return true;
+
+        p = end;
+    }
+
+    return false;
+}
